# Environment & secrets
.env
.env.local
frontend/.env.local
.mcp.json

# Python
venv/
__pycache__/
*.pyc
*.pyo

# Vector databases
# chroma_db/ — committed so Render can use it without Ollama re-embed on first deploy
chroma_db_sweep/

# Evaluation — raw data/outputs (large, generated, not for paper)
evaluation/results/*.csv
evaluation/results/*.json
evaluation/results/plots/
# evaluation/results/reports/ is NOT ignored — markdown reports tracked for paper writing

# Frontend dependencies & build output
frontend/node_modules/
frontend/dist/

# Claude Code settings (local only)
.claude/
.agents/
skills-lock.json
CLAUDE.md

# Runtime state files (machine-specific, regenerated on every run)
*_state.json

# Debug / scratch plots
scripts/*.png

# Sensor team code (contains hardcoded credentials)
MONITORING/

# Ranking app (standalone Supabase app, not part of main repo)
ranking_app/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Misc local scripts not for repo
reembed.py
