# ChickenCare AI - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chickens
DB_USER=postgres
DB_PASSWORD=your_password_here

# Ollama models (must be pulled with: ollama pull <model>)
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Scheduler (optional — default is 900 seconds / 15 minutes)
# SCHEDULER_INTERVAL=900
