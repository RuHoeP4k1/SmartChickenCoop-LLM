# ChickenCare AI - Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chickens
DB_USER=postgres
DB_PASSWORD=your_password_here

# Ollama models (must be pulled with: ollama pull <model>)
OLLAMA_MODEL=smollm2:1.7b
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe:latest

# Judge model used exclusively by the RAGAS evaluation scripts (evaluate_ragas.py,
# evaluate_retrieval.py).  Two options:
#
# Option A — Claude API (recommended, fast, reliable structured output):
#   Set ANTHROPIC_API_KEY and optionally CLAUDE_JUDGE_MODEL (defaults to claude-haiku-4-5-20251001).
#   Run: pip install langchain-anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_JUDGE_MODEL=claude-haiku-4-5-20251001
#
# Option B — local Ollama (no API key needed, but must be >= 3b):
#   Small models fail to produce the structured JSON verdicts RAGAS needs → NaN scores.
# RAGAS_JUDGE_MODEL=qwen3:4b

# ---------------------------------------------------------------------------
# Hyperparameter sweep (evaluation/sweep.py + sweep_analysis.py)
# ---------------------------------------------------------------------------

# OpenRouter — free-tier API gateway for large open-source models.
# Sign up at https://openrouter.ai — free tier, no credit card required.
# Used for:
#   • Tested LLMs: meta-llama/llama-3.1-8b-instruct:free, meta-llama/llama-3.3-70b-instruct:free
#   • Sweep judge:  google/gemini-2.0-flash-exp:free  (strong, free, different model family)
# OPENROUTER_API_KEY=sk-or-v1-...

# OpenAI — used only for the text-embedding-3-small embedding model variant.
# If you skip the OpenAI embedding condition, this key is not needed.
# OPENAI_API_KEY=sk-...

# Judge model for the sweep (must NOT be one of the tested LLMs).
# Default: google/gemini-2.0-flash-exp:free  (free on OpenRouter)
# Fallback: deepseek/deepseek-chat:free
# SWEEP_JUDGE_MODEL=google/gemini-2.0-flash-exp:free

# Scheduler interval in seconds (default 60 s)
# SCHEDULER_INTERVAL=60

# Simulation mode — inserts a fake sensor reading every 60 s for testing alerts
# Set to true while developing; set to false (or remove) when the Pi is live
# SIMULATION_MODE=false

# Number of past Q&A turns sent as context to the LLM (0 = disabled, 1–3 recommended)
# Lower = faster / less prompt bloat for small models; higher = better follow-up awareness
# CHAT_HISTORY_TURNS=2

# Coop location — used for the Weather tab (Open-Meteo, no API key needed)
# Find your coordinates at: https://www.latlong.net
# COOP_LAT=50.8798
# COOP_LON=4.7005
